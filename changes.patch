+// TinyASR on-canvas recognition progress v1
+// Owned by MediaEditorScreen, not by the language sheet. Never exported.
+final class EditorCaptionGenerationIndicator: UIView {
+    private let pill = UIVisualEffectView(effect: UIBlurEffect(style: .systemThinMaterialDark))
+    private let percent = UILabel()
+    private let bars = (0 ..< 5).map { _ in UIView() }
+    private let formatter = NumberFormatter()
+    private var request: EditorCaptionCancellation?
+    private var fraction: Double = 0.0
+    var isRunning: Bool { request != nil }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        isUserInteractionEnabled = false
+        isHidden = true
+        pill.isUserInteractionEnabled = false
+        pill.clipsToBounds = true
+        pill.layer.cornerRadius = 14.0
+        pill.layer.cornerCurve = .continuous
+        pill.contentView.backgroundColor = UIColor.black.withAlphaComponent(0.35)
+        addSubview(pill)
+        for bar in bars {
+            bar.backgroundColor = .white
+            bar.layer.cornerRadius = 1.0
+            pill.contentView.addSubview(bar)
+        }
+        percent.font = .monospacedDigitSystemFont(ofSize: 12.0, weight: .semibold)
+        percent.textColor = .white
+        percent.textAlignment = .right
+        percent.adjustsFontSizeToFitWidth = true
+        percent.minimumScaleFactor = 0.75
+        pill.contentView.addSubview(percent)
+        formatter.numberStyle = .percent
+        formatter.maximumFractionDigits = 0
+        formatter.minimumFractionDigits = 0
+        isAccessibilityElement = true
+        accessibilityTraits = .updatesFrequently
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    deinit { request?.cancel() }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        // TinyASR compact top progress pill
+        let width: CGFloat = 76.0
+        let height: CGFloat = 28.0
+        let topInset: CGFloat = 20.0
+        // Anchor to the top of the video canvas, not the caption position.
+        pill.frame = CGRect(x: floor((bounds.width - width) / 2.0), y: max(0.0, min(topInset, bounds.height - height)), width: width, height: height)
+        for (i, bar) in bars.enumerated() {
+            // Bounds and center remain stable during scale animation and relayout.
+            bar.bounds = CGRect(x: 0.0, y: 0.0, width: 2.0, height: 14.0)
+            bar.center = CGPoint(x: 11.0 + CGFloat(i) * 4.0, y: height / 2.0)
+        }
+        percent.frame = CGRect(x: 32.0, y: 0.0, width: 34.0, height: height)
+    }
+
+    private func animateWave() {
+        let heights: [[CGFloat]] = [
+            [0.35, 0.70, 0.45, 0.90, 0.35],
+            [0.65, 0.35, 1.00, 0.55, 0.65],
+            [1.00, 0.55, 0.80, 0.35, 1.00],
+            [0.45, 0.90, 0.35, 0.75, 0.45],
+            [0.70, 0.40, 0.65, 0.35, 0.70]
+        ]
+        for (i, bar) in bars.enumerated() {
+            bar.layer.removeAnimation(forKey: "tinyASRWave")
+            if UIAccessibility.isReduceMotionEnabled {
+                bar.transform = CGAffineTransform(scaleX: 1.0, y: heights[i][0])
+                continue
+            }
+            bar.transform = .identity
+            let animation = CAKeyframeAnimation(keyPath: "transform.scale.y")
+            animation.values = heights[i].map { NSNumber(value: Double($0)) }
+            animation.duration = 0.85 + Double(i) * 0.07
+            animation.repeatCount = .infinity
+            animation.calculationMode = .linear
+            bar.layer.add(animation, forKey: "tinyASRWave")
+        }
+    }
+
+    private func updateProgress(_ value: Double) {
+        guard value.isFinite else { return }
+        // Keep 100% reserved for the completed, flushed recognition result.
+        fraction = max(fraction, max(0.0, min(0.99, value)))
+        let text = formatter.string(from: NSNumber(value: fraction)) ?? "\(Int(fraction * 100))%"
+        percent.text = text
+        accessibilityValue = text
+    }
+
+    func start(asset: AVAsset, language: String, interfaceLanguage: String, completion: @escaping (Result<EditorCaptionTrack, Error>) -> Void) {
+        guard request == nil else { return }
+        let token = EditorCaptionCancellation()
+        request = token
+        formatter.locale = Locale(identifier: interfaceLanguage)
+        accessibilityLabel = interfaceLanguage.lowercased().hasPrefix("ru") ? "Распознавание речи" : "Recognizing speech"
+        fraction = 0.0
+        updateProgress(0.0)
+        isHidden = false
+        superview?.bringSubviewToFront(self)
+        setNeedsLayout()
+        layoutIfNeeded()
+        animateWave()
+        EditorCaptionRecognition.generate(asset: asset, language: language, cancellation: token, progress: { [weak self] value in
+            DispatchQueue.main.async {
+                guard let self, self.request === token else { return }
+                self.updateProgress(value)
+            }
+        }, completion: { [weak self] result in
+            guard let self, self.request === token else { return }
+            self.request = nil
+            self.hideIndicator()
+            completion(result)
+        })
+    }
+
+    private func hideIndicator() {
+        for bar in bars {
+            bar.layer.removeAnimation(forKey: "tinyASRWave")
+            bar.transform = .identity
+        }
+        isHidden = true
+    }
+
+    func cancel() {
+        request?.cancel()
+        request = nil
+        hideIndicator()
+    }
+}
