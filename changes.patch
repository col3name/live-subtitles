+// TinyASR caption compact slider v1
+private final class CaptionEditorSizeSlider: UIControl {
+    private let host = ComponentView<Empty>()
+    private let valueLabel = UILabel()
+    var minimumValue: Float = 32 { didSet { setNeedsLayout() } }
+    var maximumValue: Float = 88 { didSet { setNeedsLayout() } }
+    var value: Float = 58 {
+        didSet { if oldValue != value { setNeedsLayout() } }
+    }
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        valueLabel.font = .monospacedDigitSystemFont(ofSize: 12, weight: .medium)
+        valueLabel.textColor = captionEditorTheme.list.itemSecondaryTextColor
+        valueLabel.textAlignment = .right
+        valueLabel.isUserInteractionEnabled = false
+        valueLabel.isAccessibilityElement = false
+        addSubview(valueLabel)
+        setContentHuggingPriority(.defaultLow, for: .horizontal)
+        setContentCompressionResistancePriority(.defaultLow, for: .horizontal)
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override var intrinsicContentSize: CGSize { CGSize(width: UIView.noIntrinsicMetric, height: 44) }
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let range = maximumValue - minimumValue
+        guard bounds.height > 0, bounds.width > 70, range.isFinite, range > 0 else { return }
+        let current = value.isFinite ? max(minimumValue, min(maximumValue, value)) : minimumValue
+        // Legacy TGPhotoEditorSliderView assumes a zero or negative minimum.
+        // Map the model's positive-only font range to the unit interval instead.
+        let normalized = CGFloat((current - minimumValue) / range)
+        let percent = Int((current / 58 * 100).rounded())
+        valueLabel.text = "\(percent)%"
+        let labelWidth: CGFloat = 42
+        let inset: CGFloat = 10
+        let sliderWidth = max(1, bounds.width - labelWidth - inset * 2)
+        valueLabel.frame = CGRect(x: bounds.width - labelWidth, y: 0, width: labelWidth, height: bounds.height)
+        let size = host.update(transition: .immediate, component: AnyComponent(SliderComponent(
+            content: .continuous(SliderComponent.Continuous(
+                value: normalized, range: 0.0 ... 1.0, startValue: 0.0,
+                valueUpdated: { [weak self] fraction in
+                    guard let self, fraction.isFinite else { return }
+                    let newValue = self.minimumValue + Float(max(0, min(1, fraction))) * (self.maximumValue - self.minimumValue)
+                    guard self.value != newValue else { return }
+                    self.value = newValue
+                    self.sendActions(for: .valueChanged)
+                }
+            )),
+            trackBackgroundColor: captionEditorTheme.list.itemSecondaryTextColor.withAlphaComponent(0.22),
+            trackForegroundColor: captionEditorTheme.list.itemAccentColor,
+            knobSize: 20, trackHeight: 4,
+            accessibilityLabel: "Caption size", accessibilityValue: "\(percent) percent"
+        )), environment: {}, containerSize: CGSize(width: sliderWidth, height: 44))
+        if let content = host.view {
+            if content.superview == nil { insertSubview(content, belowSubview: valueLabel) }
+            content.frame = CGRect(x: inset, y: (bounds.height - size.height) * 0.5, width: size.width, height: size.height)
+        }
+    }
+}
