+    private let tinyASRAudioBuffer = TinyASRPlaybackAudioBuffer()
+    public func tinyASRTakePCM(position: Double, seekID: Int, consume: Bool) -> [CMSampleBuffer] {
+        return tinyASRAudioBuffer.take(position: position, seekID: seekID, consume: consume)
+    }
