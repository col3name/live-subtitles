+        let base = bounds.width / 1080
+        let rect = track.selectionRect(for: cue)
+        // Keep the selected text inside the canvas and cap the resize range.
+        let allowedScale = min((bounds.width - 8) / max(1, rect.width * base), (bounds.height - 8) / max(1, rect.height * base))
+        let s = max(0.4, min(1.8, min(scale, allowedScale)))
+        let halfWidth = min(bounds.width / 2, rect.width * base * s / 2 + 4)
+        let halfHeight = min(bounds.height / 2, rect.height * base * s / 2 + 4)
