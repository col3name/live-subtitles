@@ -133,7 +134,54 @@ final class TinyASRVideoCaptions: NSObject {
     private var lastCaptionPosition: Double?
     private var captionExpiry: DispatchWorkItem?
 
+    // TinyASR audio-clock sync v2
+    // A media-time deadline freezes on pause and follows playback rate.
+    // Do not start a fresh four-second wall-clock hold for a late ASR result.
+    private var audioSyncGeneration: UUID?
+    private var audioSyncLastPosition: Double?
+    private var audioSyncShownStart: Double?
+    private var audioSyncVisibleUntil: Double = 0.0
+
+    private func audioSynchronizedCaption(at timestamp: Double) -> CaptionBlock? {
+        guard timestamp.isFinite else { return nil }
+        if audioSyncGeneration != generation || (audioSyncLastPosition.map { timestamp < $0 - 0.25 || timestamp > $0 + 8.0 } ?? false) {
+            audioSyncGeneration = generation
+            audioSyncShownStart = nil
+            audioSyncVisibleUntil = 0.0
+        }
+        audioSyncLastPosition = timestamp
+        // No positive display lead: text starts only once the audio reaches PTS.
+        var low = 0, high = captionBlocks.count
+        while low < high {
+            let mid = (low + high) / 2
+            if captionBlocks[mid].start <= timestamp { low = mid + 1 } else { high = mid }
+        }
+        guard low > 0 else { return nil }
+        let latest = captionBlocks[low - 1]
+        // Bound lateness relative to the *spoken* words, not padded reading time.
+        let hardEnd = min(latest.start + 4.0, latest.speechEnd + 1.25)
+        guard timestamp < hardEnd else { return nil }
+        if audioSyncShownStart != latest.start {
+            audioSyncShownStart = latest.start
+            // Normally clear after a brief natural tail. If recognition arrived
+            // late, allow a short readable interval without creating a backlog.
+            audioSyncVisibleUntil = min(hardEnd, max(latest.speechEnd + 0.45, timestamp + 0.45))
+            if debugEnabled() {
