+        for x in [selectionFrame.minX, selectionFrame.maxX] {
+            path.append(UIBezierPath(ovalIn: CGRect(x: x - 6, y: selectionFrame.midY - 6, width: 12, height: 12)))
+        }
+        handles.path = path.cgPath
+        outline.isHidden = !selected; handles.isHidden = !selected
+        CATransaction.commit()
+    }
