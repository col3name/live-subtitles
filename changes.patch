+final class EditorCaptionComposerEntity: MediaEditorComposerEntity {
+    private let track: EditorCaptionTrack
+    let position: CGPoint
+    let scale: CGFloat
+    let rotation: CGFloat = 0
+    let baseSize: CGSize? = nil
+    let baseScale: CGFloat? = nil
+    let baseDrawingSize: CGSize? = CGSize(width: 1080, height: 1920)
+    let mirrored = false
+    private var cachedCue: EditorCaptionCue?
+    private var cachedFrame: MediaEditorComposerEntityFrame?
+    init(track: EditorCaptionTrack) {
+        self.track = track
+        self.position = CGPoint(x: 1080 * CGFloat(track.resolvedCenterX), y: 1920 * CGFloat(track.resolvedCenterY))
+        self.scale = CGFloat(track.resolvedCanvasScale)
+    }
+    func frame(for time: CMTime, frameRate: Float, completion: @escaping (MediaEditorComposerEntityFrame?) -> Void) {
+        guard let cue = track.cue(at: time.seconds) else { completion(nil); return }
+        if cachedCue != cue {
+            cachedCue = cue
+            cachedFrame = track.image(for: cue).cgImage.map { MediaEditorComposerEntityFrame(content: .image($0), alphaMask: nil) }
+        }
+        completion(cachedFrame)
+    }
+}
