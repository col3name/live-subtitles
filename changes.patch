+            selectionFrame = .zero; outline.isHidden = true; handles.isHidden = true
+            if editor?.values.editorCaptionTrack == nil { selected = false }
+            return
+        }
+        let factor = bounds.width / 1080 * CGFloat(track.resolvedCanvasScale)
+        let w = 960 * factor, h = 240 * factor
+        let center = CGPoint(x: bounds.width * CGFloat(track.resolvedCenterX), y: bounds.height * CGFloat(track.resolvedCenterY))
+        imageView.frame = CGRect(x: center.x - w / 2, y: center.y - h / 2, width: w, height: h)
+        if previousCue != cue || previousStyle?.fontSize != track.fontSize || previousStyle?.color != track.color || previousStyle?.background != track.background {
