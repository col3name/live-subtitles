@@ -0,0 +1,207 @@
+import UIKit
+import AVFoundation
+import Foundation
+import TinyASR
+
+/// Retain one instance per video gallery item. Call only on the main thread.
+final class TinyASRVideoCaptions: NSObject {
+    private struct Word: Decodable { let text: String; let start: Double; let end: Double }
+    private struct Failure: LocalizedError { let message: String; var errorDescription: String? { message } }
+    private let queue = DispatchQueue(label: "video.captions", qos: .utility)
+    private let label = UILabel()
+    private let button = UIButton(type: .system)
+    private var words: [Word] = []
+    private var generation = UUID()
+    private var enabled = false
+    private var loading = false
+    private var position: Double = 0
+    private var source: URL?
+    private var language = "ru"
+    private var failure: String?
+    override init() {
+        super.init()
+        label.numberOfLines = 2; label.textAlignment = .center
+        label.textColor = .white; label.backgroundColor = UIColor.black.withAlphaComponent(0.82)
+        label.font = .systemFont(ofSize: 17, weight: .semibold)
+        label.layer.cornerRadius = 6; label.clipsToBounds = true; label.isHidden = true
+        button.setTitle("CC", for: .normal); button.tintColor = .white
+        button.backgroundColor = UIColor.black.withAlphaComponent(0.65)
+        button.layer.cornerRadius = 8; button.accessibilityLabel = "Closed captions"
+        button.addTarget(self, action: #selector(toggle), for: .touchUpInside)
+    }
+    func attach(to view: UIView) {
+        if label.superview !== view { view.addSubview(label) }
+        if button.superview !== view { view.addSubview(button) }
+        view.bringSubviewToFront(label)
+        view.bringSubviewToFront(button)
+    }
+    func layout(in bounds: CGRect, controlsHeight: CGFloat, controlsVisible: Bool) {
+        let width = max(0, min(bounds.width - 32, 600))
+        label.frame = CGRect(x: bounds.midX - width / 2, y: max(bounds.minY, bounds.maxY - controlsHeight - 76), width: width, height: 60)
+        button.frame = CGRect(x: bounds.maxX - 60, y: bounds.minY + 112, width: 44, height: 40)
+        button.isHidden = !controlsVisible
+    }
+    func setSource(_ url: URL?, language: String = "ru") {
+        guard source != url || self.language != language else { return }
+        generation = UUID(); source = url; self.language = language; words = []; loading = false; failure = nil
+        if enabled { start() }; update(timestamp: 0)
+    }
+    var isEnabled: Bool { enabled }
+    @objc func toggle() {
+        enabled.toggle(); button.tintColor = enabled ? .systemBlue : .white
+        if enabled && words.isEmpty && !loading { start() }; update(timestamp: position)
+    }
+    func update(timestamp: Double) {
+        position = timestamp; label.isHidden = !enabled
+        guard enabled else { return }
+        if let failure { label.text = failure; return }
+        if loading && words.isEmpty { label.text = "Generating captions…"; return }
+        guard timestamp.isFinite else { label.isHidden = true; return }
+        // Binary search for the most recent word, then display a short phrase.
+        var low = 0, high = words.count
+        while low < high { let mid = (low + high) / 2; if words[mid].start <= timestamp { low = mid + 1 } else { high = mid } }
+        guard low > 0, timestamp <= words[low - 1].end + 0.65 else { label.isHidden = true; return }
+        var first = low - 1
+        while first > 0 && low - first < 9 && words[low - 1].start - words[first - 1].start < 3.5 && words[first].start - words[first - 1].end < 0.7 { first -= 1 }
+        label.text = words[first..<low].map(\.text).joined(separator: " ")
+    }
+    private func start() {
+        guard let source else { failure = "Download video to enable captions"; return }
+        failure = nil; loading = true; let token = generation; let language = self.language
+        queue.async { [weak self] in
+            do {
+                let result = try Self.recognize(source, language: language)
+                DispatchQueue.main.async { [weak self] in guard let self = self, self.generation == token else { return }; self.words = result; self.loading = false; self.update(timestamp: self.position) }
+            } catch {
+                DispatchQueue.main.async { [weak self] in guard let self = self, self.generation == token else { return }; self.loading = false; self.failure = error.localizedDescription; self.update(timestamp: self.position) }
+            }
+        }
+    }
+    // Models may be installed in Application Support without rebuilding Telegram.
+    // Bundled resources remain supported for offline distribution.
+    private static func localModels() throws -> (URL, URL) {
+        let fm = FileManager.default
+        var directories: [URL] = []
+        if let support = fm.urls(for: .applicationSupportDirectory, in: .userDomainMask).first {
+            directories.append(support.appendingPathComponent("TinyASR", isDirectory: true))
+        }
+        if let documents = fm.urls(for: .documentDirectory, in: .userDomainMask).first {
+            directories.append(documents.appendingPathComponent("TinyASR", isDirectory: true))
+        }
+        if let resources = Bundle.main.resourceURL {
+            directories.append(resources.appendingPathComponent("TinyASR", isDirectory: true))
+            directories.append(resources)
+        }
+        for directory in directories {
+            let model = directory.appendingPathComponent("model.tzf")
+            let vad = directory.appendingPathComponent("silero_vad.onnx")
+            if fm.isReadableFile(atPath: model.path), fm.isReadableFile(atPath: vad.path) {
+                return (model, vad)
+            }
+        }
+        throw Failure(message: "Install model.tzf and Silero VAD v5 in TinyASR models directory")
+    }
+    // MediaBox paths often have no usable media extension. Stage a named link
+    // without moving or modifying the original cached resource.
+    private static func tinyASRPreparedMediaURL(_ url: URL, directory: URL) throws -> URL {
+        let fm = FileManager.default
+        guard url.isFileURL, fm.isReadableFile(atPath: url.path) else {
+            throw Failure(message: "Video file is unavailable")
+        }
+        let attributes = try fm.attributesOfItem(atPath: url.path)
+        let size = (attributes[.size] as? NSNumber)?.int64Value ?? 0
+        guard size > 0 else { throw Failure(message: "Video file is empty") }
+        let handle = try FileHandle(forReadingFrom: url)
+        let header = handle.readData(ofLength: 64)
+        handle.closeFile()
+        let bytes = [UInt8](header)
+        let box = bytes.count >= 8 ? String(bytes: bytes[4..<8], encoding: .ascii) ?? "" : ""
+        let brand = bytes.count >= 12 ? String(bytes: bytes[8..<12], encoding: .ascii) ?? "" : ""
+        let hex = bytes.prefix(16).map { String(format: "%02x", Int($0)) }.joined(separator: " ")
+        let originalExtension = url.pathExtension.lowercased()
+        print("[TinyASR] source bytes=\(size), ext=\(originalExtension), header=\(hex), box=\(box), brand=\(brand)")
+        if String(data: header, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines).hasPrefix("#EXTM3U") == true {
+            throw Failure(message: "HLS playlist: download the original video for captions")
+        }
+        let ext: String
+        if box == "ftyp" || ["moov", "mdat", "free", "wide", "skip"].contains(box) {
+            if brand == "qt  " || originalExtension == "mov" { ext = "mov" }
+            else if brand.hasPrefix("3gp") { ext = "3gp" }
+            else { ext = "mp4" }
+        } else if bytes.starts(with: [0x1a, 0x45, 0xdf, 0xa3]) {
+            ext = originalExtension == "webm" ? "webm" : "mkv"
+        } else if bytes.count >= 12 && bytes.starts(with: [0x52, 0x49, 0x46, 0x46]) && String(bytes: bytes[8..<12], encoding: .ascii) == "AVI " {
+            ext = "avi"
+        } else if ["mp4", "mov", "m4v", "3gp", "mkv", "webm", "avi", "ts", "m4a"].contains(originalExtension) {
+            ext = originalExtension
+        } else {
+            ext = "mp4"
+        }
+        if originalExtension == ext { return url }
+        try fm.createDirectory(at: directory, withIntermediateDirectories: true, attributes: nil)
+        let stagedURL = directory.appendingPathComponent("video").appendingPathExtension(ext)
+        do {
+            try fm.linkItem(at: url, to: stagedURL)
+        } catch {
+            try fm.copyItem(at: url, to: stagedURL)
+        }
+        print("[TinyASR] prepared .\(ext) input")
+        return stagedURL
+    }
+
+    private static func recognize(_ url: URL, language: String) throws -> [Word] {
+        let (modelURL, vadURL) = try localModels()
+        let modelData = try Data(contentsOf: modelURL, options: .mappedIfSafe), vadData = try Data(contentsOf: vadURL, options: .mappedIfSafe)
+        var error = [CChar](repeating: 0, count: 1024)
+        let model = modelData.withUnsafeBytes { a in vadData.withUnsafeBytes { v in tinyasr_load(a.bindMemory(to: UInt8.self).baseAddress, a.count, v.bindMemory(to: UInt8.self).baseAddress, v.count, &error, 1024) } }
+        guard let model else { throw Failure(message: String(cString: error)) }; defer { tinyasr_free(model) }
+        tinyasr_set_threads(model, 2)
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("TinyASR-" + UUID().uuidString, isDirectory: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let preparedURL = try tinyASRPreparedMediaURL(url, directory: directory)
+        let asset = AVURLAsset(url: preparedURL, options: [AVURLAssetPreferPreciseDurationAndTimingKey: true])
+        let allTracks = asset.tracks
+        let audioTracks = asset.tracks(withMediaType: .audio)
+        let videoTracks = asset.tracks(withMediaType: .video)
+        var tracksError: NSError?
+        let tracksStatus = asset.statusOfValue(forKey: "tracks", error: &tracksError)
+        print("[TinyASR] tracks=\(allTracks.count), audio=\(audioTracks.count), video=\(videoTracks.count), playable=\(asset.isPlayable), tracksStatus=\(tracksStatus.rawValue), error=\(tracksError?.localizedDescription ?? "none")")
+        guard let track = audioTracks.first else {
+            if let tracksError {
+                throw Failure(message: "Cannot open video: \(tracksError.localizedDescription)")
+            }
+            if videoTracks.isEmpty {
+                throw Failure(message: "Cannot read media container (no tracks)")
+            }
+            throw Failure(message: "No audio track in cached video")
+        }
+        guard asset.duration.seconds.isFinite, asset.duration.seconds <= 1800 else { throw Failure(message: "Video exceeds 30 minute limit") }
+        let reader = try AVAssetReader(asset: asset)
+        let output = AVAssetReaderTrackOutput(track: track, outputSettings: [AVFormatIDKey: kAudioFormatLinearPCM, AVSampleRateKey: 16000, AVNumberOfChannelsKey: 1, AVLinearPCMBitDepthKey: 32, AVLinearPCMIsFloatKey: true, AVLinearPCMIsBigEndianKey: false, AVLinearPCMIsNonInterleaved: false])
+        guard reader.canAdd(output) else { throw Failure(message: "Unsupported audio track") }; reader.add(output)
+        guard reader.startReading() else { throw reader.error ?? Failure(message: "Cannot decode audio") }
+        var samples: [Float] = []
+        while let buffer = output.copyNextSampleBuffer() {
+            guard let block = CMSampleBufferGetDataBuffer(buffer) else { continue }
+            let bytes = CMBlockBufferGetDataLength(block)
+            guard bytes % 4 == 0 else { throw Failure(message: "Invalid PCM") }
+            let start = CMSampleBufferGetPresentationTimeStamp(buffer).seconds
+            guard start.isFinite, abs(start) <= 1800 else { throw Failure(message: "Invalid audio timestamp") }
+            let index = max(0, Int((start * 16000).rounded()))
+            if index > samples.count { samples.append(contentsOf: repeatElement(0, count: index - samples.count)) }
+            var chunk = [Float](repeating: 0, count: bytes / 4)
+            let status = chunk.withUnsafeMutableBytes { CMBlockBufferCopyDataBytes(block, atOffset: 0, dataLength: bytes, destination: $0.baseAddress!) }
+            guard status == 0 else { throw Failure(message: "PCM copy failed") }
+            samples.append(contentsOf: chunk.dropFirst(max(0, samples.count - index)))
+            guard samples.count <= 28_800_000 else { throw Failure(message: "Audio too long") }
+        }
+        guard reader.status == .completed else { throw reader.error ?? Failure(message: "Audio decoding failed") }
+        return try samples.withUnsafeBufferPointer { b in
+            guard let file = language.withCString({ tinyasr_file_new(model, b.baseAddress, b.count, $0, 4) }) else { throw Failure(message: "Recognition failed") }; defer { tinyasr_file_free(file) }
+            var result: [Word] = []
+            while let json = tinyasr_file_next(file) { result += try JSONDecoder().decode([Word].self, from: Data(String(cString: json).utf8)) }
+            return result.filter { $0.start.isFinite && $0.end.isFinite }.sorted { $0.start < $1.start }
+        }
+    }
+    deinit { label.removeFromSuperview(); button.removeFromSuperview() }
+}
