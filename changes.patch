diff --git a/submodules/AccountContext/Sources/UniversalVideoNode.swift b/submodules/AccountContext/Sources/UniversalVideoNode.swift
index 6e98693b7b..4d092c76f0 100644
--- a/submodules/AccountContext/Sources/UniversalVideoNode.swift
+++ b/submodules/AccountContext/Sources/UniversalVideoNode.swift
@@ -94,7 +94,36 @@ public enum UniversalVideoNodeFetchControl {
     case cancel
 }
 
+public struct TinyASRHLSPart {
+    public let url: URL
+    public let start: Double
+    public let end: Double
+    public let offset: Double
+    public init(url: URL, start: Double, end: Double, offset: Double) {
+        self.url = url
+        self.start = start
+        self.end = end
+        self.offset = offset
+    }
+}
+
+public protocol TinyASRHLSPartProvider: AnyObject {
+    func tinyASRBufferedParts() -> [TinyASRHLSPart]
+}
+
+public protocol TinyASRPlaybackPCMProvider: AnyObject {
+    func tinyASRTakePCM(position: Double, seekID: Int, consume: Bool) -> [CMSampleBuffer]
+}
+
 public final class UniversalVideoNode: ASDisplayNode {
+    public func tinyASRTakePCM(position: Double, seekID: Int, consume: Bool) -> [CMSampleBuffer] {
+        return (self.contentNode as? TinyASRPlaybackPCMProvider)?.tinyASRTakePCM(position: position, seekID: seekID, consume: consume) ?? []
+    }
+
+    public func tinyASRBufferedParts() -> [TinyASRHLSPart] {
+        return (self.contentNode as? TinyASRHLSPartProvider)?.tinyASRBufferedParts() ?? []
+    }
+
     private let context: AccountContext
     private let postbox: Postbox
     private let audioSession: ManagedAudioSession
