+            // when recognition finishes (the user may pause/seek meanwhile).
+            editor.maybeUnpauseVideo()
+            self.editorCaptionGeneration.start(asset: asset, language: language, interfaceLanguage: captionLanguage, completion: { [weak self, weak editor] result in
+                guard let self, let editor, self.mediaEditor === editor, let host = self.controller else { return }
+                self.stateChanged?()
+                switch result {
+                case let .success(newTrack):
+                    // Preserve the latest appearance, even if it was changed
+                    // while recognition was running. Respect deletion.
+                    if originalTrack != nil && editor.values.editorCaptionTrack == nil { return }
+                    var updated = newTrack
+                    if var existing = editor.values.editorCaptionTrack {
+                        existing.cues = newTrack.cues
+                        existing.language = newTrack.language
+                        updated = existing
+                    }
+                    self.editorCaptionsPreview.transformCommitted?(updated)
+                case let .failure(error):
+                    let detail = error.localizedDescription
+                    NSLog("TinyASR captions: %@", detail)
+                    let message: String
+                    if detail.contains("model.tzf") || detail.contains("silero_vad.onnx") {
+                        message = captionRussian ? "Модель распознавания не установлена." : "Speech model is not installed."
+                    } else if detail == "This video has no audio track." {
+                        message = captionRussian ? "В этом видео нет звука." : "This video has no audio."
+                    } else {
+                        message = captionRussian ? "Не удалось создать субтитры. Попробуйте ещё раз." : "Couldn't generate subtitles. Try again."
+                    }
+                    let alert = UIAlertController(title: message, message: nil, preferredStyle: .alert)
+                    alert.addAction(UIAlertAction(title: captionStrings.Common_Done, style: .default))
+                    host.present(alert, animated: true)
+                }
+            })
+            self.stateChanged?()
+        }
+        screen.initialTime = originalTime
+        screen.regenerateOnOpen = regenerate
+        screen.focusOnOpen = focus
+        screen.seekCaption = { [weak self, weak editor] seconds in
+            guard let self, let editor, self.mediaEditor === editor, seconds.isFinite else { return }
+            editor.seek(seconds, andPlay: false)
+        }
+        screen.previewTrack = { [weak self, weak editor] track in
+            guard let self, let editor, self.mediaEditor === editor else { return }
+            editor.values = editor.values.withUpdatedEditorCaptionTrack(track)
+        }
+        let navigation = UINavigationController(rootViewController: screen)
+        navigation.modalPresentationStyle = .pageSheet
+        navigation.overrideUserInterfaceStyle = .dark
+        // TinyASR transcript interactive dismissal v1
+        let isTranscriptSheet = originalTrack != nil && !regenerate
+        navigation.isModalInPresentation = !isTranscriptSheet
+        screen.isModalInPresentation = !isTranscriptSheet
+        if let sheet = navigation.sheetPresentationController {
+            if originalTrack == nil || regenerate {
+                if #available(iOS 16.0, *) {
+                    let compact = UISheetPresentationController.Detent.Identifier("captionsSetup")
+                    sheet.detents = [.custom(identifier: compact) { context in min(340, context.maximumDetentValue) }, .large()]
+                    sheet.selectedDetentIdentifier = compact
+                } else { sheet.detents = [.medium(), .large()]; sheet.selectedDetentIdentifier = .medium }
+            } else {
+                sheet.detents = [.medium(), .large()]; sheet.selectedDetentIdentifier = focus ? .large : .medium
+            }
+            sheet.prefersGrabberVisible = true
+            sheet.prefersScrollingExpandsWhenScrolledToEdge = false
+        }
+        if isTranscriptSheet {
+            navigation.presentationController?.delegate = screen
+        }
+        host.present(navigation, animated: true)
+    }
+}
