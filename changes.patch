+        return value.isFinite ? max(0.02, min(0.98, value)) : 0.5
+    }
+    public var resolvedCenterY: Double {
+        return position.isFinite ? max(0.02, min(0.98, position)) : 0.78
+    }
+    public var resolvedCanvasScale: Double {
+        let value = canvasScale ?? 1.0
+        return value.isFinite ? max(0.4, min(1.8, value)) : 1.0
+    }
+
+    // Coordinates inside the same 960 x 240 bitmap used for export.
+    public func selectionRect(for cue: EditorCaptionCue) -> CGRect {
+        let font = UIFont.systemFont(ofSize: CGFloat(max(32, min(88, fontSize))), weight: .semibold)
+        let paragraph = NSMutableParagraphStyle()
+        paragraph.alignment = .center
+        paragraph.lineBreakMode = .byWordWrapping
+        let attributed = NSAttributedString(string: cue.text, attributes: [.font: font, .paragraphStyle: paragraph])
+        let measured = attributed.boundingRect(with: CGSize(width: 900, height: 220), options: [.usesLineFragmentOrigin, .usesFontLeading], context: nil)
+        let width = min(940, max(44, ceil(measured.width) + 36))
+        let height = min(240, max(44, ceil(measured.height) + 24))
+        return CGRect(x: (960 - width) / 2, y: (240 - height) / 2, width: width, height: height)
+    }
+    public var language: String = "ru"
+
+    public func cue(at time: Double) -> EditorCaptionCue? {
+        guard time.isFinite else { return nil }
+        var low = 0, high = cues.count
+        while low < high {
+            let mid = (low + high) / 2
+            if cues[mid].start <= time { low = mid + 1 } else { high = mid }
+        }
+        guard low > 0, time < cues[low - 1].end else { return nil }
+        return cues[low - 1]
+    }
+
+    // The same transparent bitmap is used in preview and the frame compositor.
+    public func image(for cue: EditorCaptionCue) -> UIImage {
+        let size = CGSize(width: 960, height: 240)
+        let format = UIGraphicsImageRendererFormat()
+        format.scale = 1
+        format.opaque = false
+        return UIGraphicsImageRenderer(size: size, format: format).image { context in
+            let font = UIFont.systemFont(ofSize: CGFloat(max(32, min(88, fontSize))), weight: .semibold)
+            let paragraph = NSMutableParagraphStyle()
+            paragraph.alignment = .center
+            paragraph.lineBreakMode = .byWordWrapping
+            let foreground: UIColor = .white
+            let shadow = NSShadow()
+            shadow.shadowColor = UIColor.black.withAlphaComponent(0.9)
+            shadow.shadowBlurRadius = 6
+            shadow.shadowOffset = CGSize(width: 0, height: 2)
+            let attributed = NSAttributedString(string: cue.text, attributes: [.font: font, .foregroundColor: foreground, .paragraphStyle: paragraph, .shadow: shadow])
+            let measured = attributed.boundingRect(with: CGSize(width: 900, height: 220), options: [.usesLineFragmentOrigin, .usesFontLeading], context: nil)
+            let height = min(220, ceil(measured.height))
+            let rect = CGRect(x: 30, y: (size.height - height) / 2, width: 900, height: height)
+            if background {
+                let width = min(940, ceil(measured.width) + 36)
+                context.cgContext.setFillColor(UIColor.black.withAlphaComponent(0.75).cgColor)
+                UIBezierPath(roundedRect: CGRect(x: (960 - width) / 2, y: rect.minY - 12, width: width, height: height + 24), cornerRadius: 18).fill()
+            }
+            attributed.draw(with: rect, options: [.usesLineFragmentOrigin, .usesFontLeading, .truncatesLastVisibleLine], context: nil)
+        }
+    }
+}
