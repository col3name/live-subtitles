+public enum EditorCaptionRecognition {
+    private struct Word: Decodable { let text: String; let start: Double; let end: Double }
+    private struct Event: Decodable { let type: String; let words: [Word]? }
+    private struct Failure: LocalizedError {
+        let message: String
+        var errorDescription: String? { message }
+    }
+    private static func models() throws -> (Data, Data) {
+        let fm = FileManager.default
+        var dirs = [FileManager.SearchPathDirectory.applicationSupportDirectory, .documentDirectory].compactMap { fm.urls(for: $0, in: .userDomainMask).first?.appendingPathComponent("TinyASR") }
+        if let bundle = Bundle.main.resourceURL { dirs += [bundle.appendingPathComponent("TinyASR"), bundle] }
+        for dir in dirs {
+            let a = dir.appendingPathComponent("model.tzf"), b = dir.appendingPathComponent("silero_vad.onnx")
+            if fm.isReadableFile(atPath: a.path), fm.isReadableFile(atPath: b.path) {
+                return (try Data(contentsOf: a, options: .mappedIfSafe), try Data(contentsOf: b, options: .mappedIfSafe))
+            }
+        }
+        throw Failure(message: "Install model.tzf and silero_vad.onnx in TinyASR.")
+    }
+
+    public static func generate(asset: AVAsset, language: String, cancellation: EditorCaptionCancellation, progress: @escaping (Double) -> Void, completion: @escaping (Result<EditorCaptionTrack, Error>) -> Void) {
+        DispatchQueue.global(qos: .userInitiated).async {
+            let result = Result { try recognize(asset: asset, language: language, cancellation: cancellation, progress: progress) }
+            DispatchQueue.main.async { completion(result) }
+        }
+    }
+
+    private static func recognize(asset: AVAsset, language: String, cancellation: EditorCaptionCancellation, progress: @escaping (Double) -> Void) throws -> EditorCaptionTrack {
+        guard let track = asset.tracks(withMediaType: .audio).first else { throw Failure(message: "This video has no audio track.") }
+        let duration = asset.duration.seconds
+        guard duration.isFinite, duration > 0 else { throw Failure(message: "The video is not ready.") }
+        let (a, v) = try models()
+        var error = [CChar](repeating: 0, count: 1024)
+        let handle = a.withUnsafeBytes { aa in v.withUnsafeBytes { vv in
+            tinyasr_load(aa.bindMemory(to: UInt8.self).baseAddress, aa.count, vv.bindMemory(to: UInt8.self).baseAddress, vv.count, &error, 1024)
+        } }
+        guard let handle else { throw Failure(message: String(cString: error)) }
+        defer { tinyasr_free(handle); withExtendedLifetime(a) {}; withExtendedLifetime(v) {} }
+        tinyasr_set_threads(handle, 2)
+        guard let session = language.withCString({ tinyasr_session_new(handle, $0, $0, nil, 4) }) else { throw Failure(message: "Cannot initialize caption recognition.") }
+        defer { tinyasr_session_free(session) }
+        let reader = try AVAssetReader(asset: asset)
+        let output = AVAssetReaderTrackOutput(track: track, outputSettings: [AVFormatIDKey: kAudioFormatLinearPCM, AVSampleRateKey: 16000, AVNumberOfChannelsKey: 1, AVLinearPCMBitDepthKey: 32, AVLinearPCMIsFloatKey: true, AVLinearPCMIsBigEndianKey: false, AVLinearPCMIsNonInterleaved: false])
+        guard reader.canAdd(output) else { throw Failure(message: "Cannot decode video audio.") }
+        reader.add(output)
+        guard reader.startReading() else { throw reader.error ?? Failure(message: "Cannot read video audio.") }
+        defer { if reader.status == .reading { reader.cancelReading() } }
+        var words: [Word] = []
+        var origin: Double?
+        var sampleCount: Int64 = 0
+        var lastProgress = -1.0
+        func receive(_ json: UnsafePointer<CChar>?) throws {
+            guard let json else { throw Failure(message: "TinyASR returned no result.") }
+            let events = try JSONDecoder().decode([Event].self, from: Data(String(cString: json).utf8))
+            for event in events where event.type == "commit" { words.append(contentsOf: event.words ?? []) }
+        }
+        func push(_ pcm: [Float]) throws {
+            try pcm.withUnsafeBufferPointer { buffer in
+                guard let base = buffer.baseAddress else { return }
+                var offset = 0
+                while offset < buffer.count {
+                    if cancellation.isCancelled { throw CancellationError() }
+                    let count = min(320, buffer.count - offset)
+                    try receive(tinyasr_session_push(session, base.advanced(by: offset), count))
+                    sampleCount += Int64(count)
+                    offset += count
+                }
+            }
+        }
+        while let buffer = output.copyNextSampleBuffer() {
+            if cancellation.isCancelled { throw CancellationError() }
+            let pts = CMSampleBufferGetPresentationTimeStamp(buffer).seconds
+            guard pts.isFinite, let block = CMSampleBufferGetDataBuffer(buffer) else { continue }
+            let bytes = CMBlockBufferGetDataLength(block)
+            guard bytes > 0, bytes % 4 == 0 else { continue }
+            if origin == nil { origin = pts }
+            let expected = Int64(((pts - (origin ?? pts)) * 16000).rounded())
+            var gap = expected - sampleCount
+            // Preserve source time across discontinuous audio, without allocating the whole gap.
+            while gap > 320 {
+                let count = Int(min(16000, gap))
+                try push([Float](repeating: 0, count: count)); gap -= Int64(count)
+            }
+            var pcm = [Float](repeating: 0, count: bytes / 4)
+            let status = pcm.withUnsafeMutableBytes { CMBlockBufferCopyDataBytes(block, atOffset: 0, dataLength: bytes, destination: $0.baseAddress!) }
+            guard status == noErr else { throw Failure(message: "Cannot copy PCM audio.") }
+            let overlap = max(0, sampleCount - expected)
+            if overlap < Int64(pcm.count) { try push(Array(pcm.dropFirst(Int(overlap)))) }
+            let fraction = max(0, min(1, pts / duration))
+            if fraction - lastProgress >= 0.01 { lastProgress = fraction; DispatchQueue.main.async { progress(fraction) } }
+        }
+        guard reader.status == .completed else { throw reader.error ?? Failure(message: "Audio decoding stopped.") }
+        if cancellation.isCancelled { throw CancellationError() }
+        try receive(tinyasr_session_finish(session))
+        let offset = origin ?? 0
+        var flattened: [Word] = []
+        for word in words where word.start.isFinite && word.end.isFinite && word.end >= word.start {
+            let pieces = word.text.split(whereSeparator: { $0.isWhitespace })
+            let step = (word.end - word.start) / Double(max(1, pieces.count))
+            for (i, piece) in pieces.enumerated() {
+                flattened.append(Word(text: String(piece), start: max(0, offset + word.start + Double(i) * step), end: min(duration, offset + word.start + Double(i + 1) * step)))
+            }
+        }
+        flattened.sort { $0.start < $1.start }
+        var unique: [Word] = []
+        for word in flattened where word.end >= word.start && word.start < duration {
+            if let last = unique.last, last.text == word.text, abs(last.start - word.start) < 0.1 { continue }
+            unique.append(word)
+        }
+        guard unique.count > 2 else { throw Failure(message: "Not enough spoken words to generate captions.") }
+        var cues: [EditorCaptionCue] = []
+        var group: [Word] = []
+        func flush() {
+            guard let first = group.first, let last = group.last else { return }
+            let text = group.map(\.text).joined(separator: " ")
+            cues.append(EditorCaptionCue(start: first.start, end: min(duration, max(last.end, first.start + 0.7), first.start + 4), text: text))
+            group.removeAll(keepingCapacity: true)
+        }
+        for word in unique {
+            if let first = group.first, let last = group.last, group.count >= 10 || word.start - last.end > 0.65 || word.end - first.start > 4 || group.map(\.text).joined(separator: " ").count + 1 + word.text.count > 56 { flush() }
+            group.append(word)
+            if group.count >= 3, let last = word.text.last, ".!?…".contains(last) { flush() }
+        }
+        flush()
+        for i in cues.indices.dropLast() { cues[i].end = min(cues[i].end, cues[i + 1].start) }
+        cues = cues.filter { $0.end > $0.start }
+        var result = EditorCaptionTrack(cues: cues)
+        result.language = language
+        return result
+    }
+}
