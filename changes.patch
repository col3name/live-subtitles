+// TinyASR: bounded, opt-in copy of decoded PCM from this player only.
+final class TinyASRPlaybackAudioBuffer {
+    private struct Entry {
+        let buffer: CMSampleBuffer
+        let start: Double
+        let end: Double
+    }
+    private let lock = NSLock()
+    private var entries: [Entry] = []
+    private var requestedSeek: Int?
+    private var leaseUntil: TimeInterval = 0
+
+    func offer(_ buffer: CMSampleBuffer, seekID: Int) {
+        lock.lock(); defer { lock.unlock() }
+        guard ProcessInfo.processInfo.systemUptime < leaseUntil else { entries.removeAll(keepingCapacity: true); return }
+        guard requestedSeek == seekID else { return }
+        let start = CMSampleBufferGetPresentationTimeStamp(buffer).seconds
+        let count = CMSampleBufferGetNumSamples(buffer)
+        guard start.isFinite, count > 0, count <= 16384,
+              let format = CMSampleBufferGetFormatDescription(buffer),
+              let asbd = CMAudioFormatDescriptionGetStreamBasicDescription(format) else { return }
+        let rate = asbd.pointee.mSampleRate
+        guard rate.isFinite, rate >= 8000, rate <= 192000,
+              asbd.pointee.mFormatID == kAudioFormatLinearPCM else { return }
+        let end = start + Double(count) / rate
+        if let last = entries.last, start < last.start - 0.1 { entries.removeAll(keepingCapacity: true) }
+        entries.append(Entry(buffer: buffer, start: start, end: end))
+        while entries.count > 512 || (entries.first.map { end - $0.start > 12.0 } ?? false) {
+            entries.removeFirst()
+        }
+    }
+
+    func take(position: Double, seekID: Int, consume: Bool) -> [CMSampleBuffer] {
+        lock.lock(); defer { lock.unlock() }
+        guard position.isFinite else { return [] }
+        let now = ProcessInfo.processInfo.systemUptime
+        if requestedSeek != seekID || now >= leaseUntil {
+            entries.removeAll(keepingCapacity: true)
+            requestedSeek = seekID
+        }
+        leaseUntil = now + 8.0
+        entries.removeAll { $0.end < position - 4.0 || $0.start > position + 30.0 }
+        guard consume, let first = entries.first else { return [] }
+        // Do not read too far ahead of the displayed video, or mix discontinuous PCM.
+        guard first.start <= position + 8.0 else { return [] }
+        var count = 0
+        var end = first.start
+        for entry in entries {
+            if count > 0 && entry.start - end > 0.20 { break }
+            count += 1
+            end = max(end, entry.end)
+            if end - first.start >= 2.5 { break }
+        }
+        let span = end - first.start
+        guard span >= 2.5 || (count < entries.count && span >= 0.05) ||
+            (span >= 0.15 && position >= end - 0.1) else { return [] }
+        let result = entries.prefix(count).map(\.buffer)
+        entries.removeFirst(count)
+        return result
+    }
+}
+
