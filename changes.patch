+            selectedId: AnyHashable(selectedSegmentIndex), fillWidth: true,
+            action: { [weak self] id in
+                guard let self, let index = id.base as? Int, self.items.indices.contains(index), self.selectedSegmentIndex != index else { return }
+                self.selectedSegmentIndex = index
+                self.sendActions(for: .valueChanged)
+            }
+        )), environment: {}, containerSize: bounds.size)
+        if let content = host.view {
